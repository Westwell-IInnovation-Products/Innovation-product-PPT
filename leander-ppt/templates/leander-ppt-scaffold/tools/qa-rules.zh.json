{
  "version": "qa-rules.zh.v2",
  "ruleSets": {
    "universal": [
      "u.geometry.overlap",
      "u.geometry.bounds",
      "u.geometry.connector",
      "u.layout.center",
      "u.type.hierarchy",
      "u.type.font",
      "u.color.semantic",
      "u.visual.explanation",
      "u.summary.rationale",
      "u.truth.boundary"
    ],
    "blueprint.contract": [
      "b.signature",
      "b.expression",
      "b.skeleton",
      "b.handoff",
      "b.color"
    ],
    "relationship.sequence": ["r.sequence.direction", "r.sequence.io", "r.sequence.gate"],
    "relationship.state": ["r.state.problem", "r.state.locality", "r.state.truth"],
    "relationship.toolbox": ["r.toolbox.categories", "r.toolbox.selection", "r.toolbox.visual"],
    "relationship.system-map": ["r.system.structure", "r.system.path", "r.system.truth"],
    "relationship.ecosystem": ["r.system.structure", "r.evidence.source", "r.evidence.claim"],
    "relationship.hierarchy": ["r.hierarchy.level", "r.hierarchy.connector"],
    "relationship.contrast": ["r.contrast.scale", "r.contrast.mapping", "r.contrast.conclusion"],
    "relationship.evidence": ["r.evidence.source", "r.evidence.readability", "r.evidence.claim"],
    "relationship.scene": ["r.scene.information", "r.scene.image2", "r.scene.source"],
    "relationship.decision": ["r.decision.criteria", "r.decision.tradeoff"],
    "relationship.lifecycle": ["r.lifecycle.direction", "r.lifecycle.promotion"],
    "relationship.cover": ["r.cover.chrome", "r.cover.whitespace"],
    "route.component-library": ["v.component.runtime", "v.component.capacity", "v.component.risk"],
    "route.external-graphic": ["v.external.source", "v.external.annotation", "v.external.redaction"],
    "route.image2": ["v.image2.prompt", "v.image2.simple", "v.image2.integration"],
    "route.page-specific-custom": ["v.custom.reason", "v.custom.structure", "v.custom.promotion"],
    "route.theme-chrome": ["v.chrome.signature", "v.chrome.content"],
    "evidence.implementation": ["e.implementation.status", "e.implementation.artifact"],
    "evidence.screenshot": ["e.screenshot.slot", "e.screenshot.proof", "e.screenshot.redaction"]
  },
  "rules": {
    "u.geometry.overlap": {"severity":"P0","label":"无非意图重叠","evidence":"render-location"},
    "u.geometry.bounds": {"severity":"P0","label":"无溢出、裁切或越界","evidence":"render-location"},
    "u.geometry.connector": {"severity":"P0","label":"连接线不歪斜、不穿框、不误导","evidence":"render-location"},
    "u.layout.center": {"severity":"P1","label":"主体在内容安全区内形成有意的视觉中心","evidence":"render-location"},
    "u.type.hierarchy": {"severity":"P0","label":"同级字号、基线和间距一致，文字不压框","evidence":"render-location"},
    "u.type.font": {"severity":"P1","label":"中英文字体遵守主题合同，不混用未知字体","evidence":"render-location"},
    "u.color.semantic": {"severity":"P1","label":"非中性色承担明确逻辑或设计意义","evidence":"render-location"},
    "u.visual.explanation": {"severity":"P1","label":"主体是视觉解释，不是平均铺开的文字卡片","evidence":"render-location"},
    "u.summary.rationale": {"severity":"P1","label":"底部总结或方框只在承担结论、证据、状态或转折时出现","evidence":"render-location"},
    "u.truth.boundary": {"severity":"P0","label":"结论、状态、数据和实现边界不虚构","evidence":"source-reference"},
    "b.signature": {"severity":"P1","label":"最终表达保持蓝图视觉签名","evidence":"contract-compare"},
    "b.expression": {"severity":"P1","label":"表达模式与页面任务一致","evidence":"contract-compare"},
    "b.skeleton": {"severity":"P1","label":"没有退回蓝图禁用的通用骨架","evidence":"contract-compare"},
    "b.handoff": {"severity":"P1","label":"页面仍承担既定故事角色和前后承接","evidence":"contract-compare"},
    "b.color": {"severity":"P1","label":"强调对象和颜色语义符合蓝图","evidence":"contract-compare"},
    "r.sequence.direction": {"severity":"P1","label":"起点、阶段、终点和方向清楚","evidence":"render-location"},
    "r.sequence.io": {"severity":"P1","label":"阶段输入、动作、产出可见","evidence":"render-location"},
    "r.sequence.gate": {"severity":"P1","label":"人工确认或门禁节点被明确标记","evidence":"render-location"},
    "r.state.problem": {"severity":"P1","label":"状态机制回应了明确的原问题","evidence":"render-location"},
    "r.state.locality": {"severity":"P1","label":"局部隔离、当前状态和可恢复性可见","evidence":"render-location"},
    "r.state.truth": {"severity":"P0","label":"文件、目录和状态结构与真实机制一致","evidence":"source-reference"},
    "r.toolbox.categories": {"severity":"P1","label":"工具类别和职责边界清楚","evidence":"render-location"},
    "r.toolbox.selection": {"severity":"P1","label":"页面意图到工具选择的路径清楚","evidence":"contract-compare"},
    "r.toolbox.visual": {"severity":"P2","label":"工具类别有可识别的视觉表达，不只列文字","evidence":"render-location"},
    "r.system.structure": {"severity":"P1","label":"模块、输入、输出和依赖关系清楚","evidence":"render-location"},
    "r.system.path": {"severity":"P1","label":"中心节点或主路径明确","evidence":"render-location"},
    "r.system.truth": {"severity":"P0","label":"概念架构与已实现结构被明确区分","evidence":"source-reference"},
    "r.hierarchy.level": {"severity":"P1","label":"父子层级和展开关系一眼可见","evidence":"render-location"},
    "r.hierarchy.connector": {"severity":"P0","label":"层级连线正交或具有明确曲线逻辑","evidence":"render-location"},
    "r.contrast.scale": {"severity":"P1","label":"对比双方同尺度、同层级","evidence":"render-location"},
    "r.contrast.mapping": {"severity":"P1","label":"问题和解决机制一一对应","evidence":"render-location"},
    "r.contrast.conclusion": {"severity":"P1","label":"结论能从对比结构自然得出","evidence":"render-location"},
    "r.evidence.source": {"severity":"P0","label":"证据来源和边界明确","evidence":"source-reference"},
    "r.evidence.readability": {"severity":"P1","label":"数字、单位、标签和截图可读","evidence":"render-location"},
    "r.evidence.claim": {"severity":"P0","label":"结论没有超出证据支持范围","evidence":"source-reference"},
    "r.scene.information": {"severity":"P1","label":"图片承担真实信息而不是装饰","evidence":"render-location"},
    "r.scene.image2": {"severity":"P1","label":"生成图只承担一个简单意象，不包含小字或复杂流程","evidence":"render-location"},
    "r.scene.source": {"severity":"P0","label":"外部图有来源和使用边界","evidence":"source-reference"},
    "r.decision.criteria": {"severity":"P1","label":"判断标准和推荐项明确","evidence":"render-location"},
    "r.decision.tradeoff": {"severity":"P1","label":"展示真实取舍，不使用伪打分","evidence":"source-reference"},
    "r.lifecycle.direction": {"severity":"P1","label":"循环方向或演进路径清楚","evidence":"render-location"},
    "r.lifecycle.promotion": {"severity":"P1","label":"反馈、沉淀和提升位置明确","evidence":"render-location"},
    "r.cover.chrome": {"severity":"P1","label":"封面遵守主题 chrome","evidence":"render-location"},
    "r.cover.whitespace": {"severity":"P1","label":"封面标题层级清楚并保留足够留白","evidence":"render-location"},
    "v.component.runtime": {"severity":"P0","label":"真实运行轨迹包含所选组件","evidence":"component-trace"},
    "v.component.capacity": {"severity":"P1","label":"内容数量和槽位容量匹配，不靠缩字硬塞","evidence":"contract-compare"},
    "v.component.risk": {"severity":"P1","label":"组件风险和避免条件已检查","evidence":"render-location"},
    "v.external.source": {"severity":"P0","label":"外部图有真实来源","evidence":"source-reference"},
    "v.external.annotation": {"severity":"P1","label":"外部图有明确重点标注","evidence":"render-location"},
    "v.external.redaction": {"severity":"P0","label":"敏感信息完成脱敏判断","evidence":"source-reference"},
    "v.image2.prompt": {"severity":"P1","label":"存在可复现的 prompt-spec","evidence":"source-reference"},
    "v.image2.simple": {"severity":"P1","label":"生成图没有复杂流程、小字或混乱细节","evidence":"render-location"},
    "v.image2.integration": {"severity":"P1","label":"图片与页面背景和标注融合","evidence":"render-location"},
    "v.custom.reason": {"severity":"P1","label":"记录不用现有组件或图片路线的原因","evidence":"contract-compare"},
    "v.custom.structure": {"severity":"P1","label":"自定义页面没有退化为临时文本框堆叠","evidence":"render-location"},
    "v.custom.promotion": {"severity":"P2","label":"可复用结构已判断是否需要沉淀","evidence":"source-reference"},
    "v.chrome.signature": {"severity":"P1","label":"封面、转场和封底使用正确主题签名","evidence":"render-location"},
    "v.chrome.content": {"severity":"P1","label":"chrome 页面没有加入无关解释框","evidence":"render-location"},
    "e.implementation.status": {"severity":"P0","label":"implemented、partial、proposed 等状态口径准确","evidence":"source-reference"},
    "e.implementation.artifact": {"severity":"P0","label":"实现状态能指向真实文件、脚本、截图或公开来源","evidence":"source-reference"},
    "e.screenshot.slot": {"severity":"P1","label":"截图槽位尺寸、来源和裁剪规则完整","evidence":"contract-compare"},
    "e.screenshot.proof": {"severity":"P1","label":"截图旁说明它证明什么","evidence":"render-location"},
    "e.screenshot.redaction": {"severity":"P0","label":"截图完成敏感信息检查","evidence":"source-reference"}
  }
}
